# Create the bot with the official @botfather inside Bale and keep its token secret.
BALE_BOT_TOKEN=

# Numeric Bale user IDs, comma-separated. Start with the owner only.
ALLOWED_BALE_IDS=

# HTTPS API on the Zoppini NestJS backend.
ZOPPINI_SITE_API_BASE_URL=https://zoppinico.com/api/bot/v1
ZOPPINI_BOT_SERVICE_TOKEN=

POLLING_TIMEOUT_SECONDS=25
