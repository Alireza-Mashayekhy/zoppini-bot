# کپی این فایل به نام .env و پرکردن مقادیر. فایل .env را هرگز وارد Git نکنید.

# توکن ربات بله — از بات‌فادر رسمی بله (@botfather) گرفته می‌شود. مثل رمز اصلی ربات است.
BALE_BOT_TOKEN=

# شناسه‌های عددی بلهٔ مدیرهای مجاز، جداشده با ویرگول. اول فقط شناسهٔ مالک.
# هر نفر در گفت‌وگوی خصوصی با ربات /id می‌فرستد تا شناسه‌اش را بگیرد.
ALLOWED_BALE_IDS=

# API گزارش‌های سایت (بک‌اند NestJS). مسیر پایه با /api/bot/v1 تمام می‌شود.
ZOPPINI_SITE_API_BASE_URL=https://zoppinico.com/api/bot/v1

# secret مشترک ربات و بک‌اند سایت؛ عین همین مقدار باید در محیط بک‌اند هم باشد.
# ساخت مقدار قوی: openssl rand -hex 32
ZOPPINI_BOT_SERVICE_TOKEN=

# مهلت long polling از بله (ثانیه، ۱ تا ۵۰)
POLLING_TIMEOUT_SECONDS=25

# اختیاری — فقط برای تست لوکال با سرور جعلی بله؛ در حالت عادی خالی/حذف شود.
# BALE_API_BASE_URL=https://tapi.bale.ai
