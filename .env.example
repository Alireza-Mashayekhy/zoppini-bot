# ==============================================================================
# تنظیمات سرویس ربات مدیریتی Zoppini روی بله (Bale)
# این فایل فقط نمونه است؛ مقادیر واقعی را فقط در فایل .env روی سرور یا Secret Manager قرار دهید.
# ==============================================================================

# ۱. توکن ربات بله (دریافتی از @botfather در بله — جدا از کلید سرویس سایت)
BALE_BOT_TOKEN=

# ۲. شناسه‌های عددی بلهٔ مالکان اصلی (برای هشدار اضطراری قطع ارتباط سایت و سازگاری اولیه)
# مثال: OWNER_BALE_IDS=123456789,987654321
OWNER_BALE_IDS=
ALLOWED_BALE_IDS=

# ۳. آدرس پایهٔ API اختصاصی ربات در بک‌اند NestJS (بدون اسلش پایانی)
ZOPPINI_SITE_API_BASE_URL=https://zoppini.ir/api/bot/v1

# ۴. کلید سرویس اختصاصی ربات به سایت (کاملاً جدا از BALE_BOT_TOKEN و پنل ادمین وب)
# دستور ساخت کلید قوی: openssl rand -hex 32
ZOPPINI_BOT_SERVICE_TOKEN=

# ۵. کلید امضای HMAC هویت کاربر (اختیاری؛ اگر خالی باشد به‌صورت مشتق رمزنگاری‌شده از ZOPPINI_BOT_SERVICE_TOKEN ساخته می‌شود)
ZOPPINI_BOT_SIGNING_SECRET=

# ۶. تنظیمات اختیاری اجرایی
# BALE_API_BASE_URL=https://tapi.bale.ai
# POLLING_TIMEOUT_SECONDS=25
# OUTBOX_POLL_INTERVAL_MS=5000
# BALE_MAX_DOCUMENT_BYTES=8388608
# BOT_STATE_FILE=./data/bot-state.json
# BOT_HEARTBEAT_FILE=/tmp/bot-heartbeat.json

# ==============================================================================
# متغیرهای متناظر در سرویس بک‌اند سایت (back/.env):
#   ZOPPINI_BOT_SERVICE_TOKEN=<همان کلید سرویس بالا>
#   ZOPPINI_BOT_SERVICE_TOKEN_PREVIOUS=<کلید قبلی در بازهٔ چرخش بدون قطعی کلید>
#   ZOPPINI_BOT_SIGNING_SECRET=<در صورت تنظیم در ربات، همان مقدار>
#   ZOPPINI_BOT_SIGNING_SECRET_PREVIOUS=<کلید امضای قبلی هنگام چرخش>
#   ZOPPINI_BOT_OWNER_BALE_IDS=<شناسهٔ عددی بلهٔ مالک اصلی فروشگاه>
#   ZOPPINI_BOT_ROLE_MAP=<اختیاری: مثلاً 111:owner,222:admin,333:orders-read-only>
#   BOT_OUTBOX_RETENTION_DAYS=30
# ==============================================================================
